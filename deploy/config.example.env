# Copy to deploy/config.env (gitignored) and fill in. Read by the scripts in this folder.
PROJECT_ID=
REGION=
BILLING_ACCOUNT=
# Budget amount with the billing account's currency code, e.g. 1000USD.
BUDGET_AMOUNT=

# Vertex AI location for the models (not the Cloud Run region).
VERTEX_LOCATION=global

SERVICE=nutrilens-api
REPO=nutrilens
SERVICE_ACCOUNT_NAME=nutrilens-api
SQL_INSTANCE=nutrilens-pg
DB_NAME=nutrilens
DB_USER=nutrilens_app
DB_SECRET=nutrilens-db-password

# Upper bound on instances, which also bounds the in-memory rate limiter's reach.
MAX_INSTANCES=3
