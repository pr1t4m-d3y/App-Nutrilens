# Copy to backend/.env for local use. Never commit the real file.
# No model API keys are needed: Vertex AI uses application default credentials
# (`gcloud auth application-default login` locally, the service account on Cloud Run).

FIREBASE_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Model IDs; defaults are in nutrilens_api/config.py.
# AGENT_LIGHT_MODEL=
# AGENT_MAX_SEARCHES=6
# GENERATION_MODEL=
# FALLBACK_MODEL=
# EMBEDDING_MODEL=
# EMBEDDING_DIM=768

# Cloud SQL (Cloud Run: /cloudsql/PROJECT:REGION:INSTANCE). Locally: the Cloud SQL Auth Proxy host.
DB_HOST=
DB_NAME=nutrilens
DB_USER=nutrilens_app
DB_PASSWORD=

# Optional: per-million-token prices from the current Google Cloud price list,
# so each request can log its cost. Leave unset to log no cost.
# PRICE_INPUT_PER_MTOK=
# PRICE_OUTPUT_PER_MTOK=
